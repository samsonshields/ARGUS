@page "/"
@inject InvestigationClient Client
@inject SourceClient Sources
@inject IntelligenceApiClient Intelligence
<PageTitle>ARGUS | Dashboard</PageTitle>
<h1>Investigation dashboard</h1>
<p class="muted">Follow source evidence from collection and review through timelines, geographic context and analytical reports.</p>
@if (error is not null) { <ErrorNotice Message="@error" /><a href="/">Retry</a> }
else if (items is null) { <p role="status">Loading dashboard...</p> }
else
{
    <div class="workspace-summary">
        <section><h2>Investigations</h2><dl>
            <div><dt>Total investigations</dt><dd>@items.Count</dd></div>
            <div><dt>Active workspaces</dt><dd>@items.Count(x => x.Status == InvestigationStatus.Active)</dd></div>
            <div><dt>Archived investigations</dt><dd>@items.Count(x => x.Status == InvestigationStatus.Archived)</dd></div>
        </dl><a href="/investigations">Open investigation library</a></section>
        <section><h2>Evidence and review</h2><dl>
            <div><dt>Imported sources</dt><dd>@statistics?.Total</dd></div>
            <div><dt>Text extraction complete / failed</dt><dd>@statistics?.Ready / @statistics?.Failed</dd></div>
            <div><dt>Approved entities</dt><dd>@intelligence?.ApprovedEntities</dd></div>
        </dl><p class="muted">@(intelligence?.Proposed ?? 0) entity mentions await analyst review.</p></section>
        <section><h2>Processing and connections</h2><dl>
            <div><dt>Active / failed jobs</dt><dd>@intelligence?.PendingJobs / @intelligence?.FailedJobs</dd></div>
            <div><dt>Proposed relationships</dt><dd>@intelligence?.ProposedRelationships</dd></div>
            <div><dt>Reviewed relationships</dt><dd>@intelligence?.ApprovedRelationships</dd></div>
        </dl><a href="/processing-jobs">Open processing monitor</a></section>
    </div>
    <div class="section-heading"><h2>Recently updated</h2><a class="button" href="/investigations/new">New investigation</a></div>
    @if (items.Count == 0) { <div class="panel"><h3>Your workspace is ready</h3><p>Create an investigation to define its research scope.</p></div> }
    @foreach (var item in items.Take(5))
    {
        <a class="investigation-row" href="@($"/investigations/{item.Id}")"><strong>@item.Title</strong><span>@item.Status / @item.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span></a>
    }
}
@code {
    private List<InvestigationResponse>? items;
    private string? error;
    private SourceStatistics? statistics;
    private IntelligenceStatistics? intelligence;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var investigationsTask = Client.ListAsync(); var sourcesTask = Sources.StatisticsAsync(); var intelligenceTask = Intelligence.StatisticsAsync();
            await Task.WhenAll(investigationsTask, sourcesTask, intelligenceTask);
            items = await investigationsTask; statistics = await sourcesTask; intelligence = await intelligenceTask;
        }
        catch (HttpRequestException) { error = "Cannot reach the API. Check that it is running, then retry."; }
        catch (TaskCanceledException) { error = "The API request timed out. Please retry."; }
    }
}

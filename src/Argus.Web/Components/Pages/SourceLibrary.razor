@page "/investigations/{Id:guid}/sources"
@rendermode InteractiveServer
@inject SourceClient Sources
@inject InvestigationClient Investigations
@inject NavigationManager Navigation
<PageTitle>ARGUS | Source library</PageTitle>
<InvestigationNav Id="Id" />
<div class="page-head">
    <div>
        <h1>Sources</h1>
        <p class="lede">Original documents are preserved unchanged. Extracted text becomes the snapshot every citation points back to.</p>
    </div>
</div>
@if (error is not null) { <ErrorNotice Message="@error" /> }
@if (duplicateId.HasValue) { <a href="@($"/sources/{duplicateId}")">Open existing source</a> }
@if (loading) { <p role="status">Loading sources…</p> }
else if (investigation is not null && limits is not null)
{
    <details class="panel" open="@(items.Count == 0)">
        <summary>Import a source</summary>
        <p class="muted">Text and extractable PDF files, up to @(limits.MaxFileBytes / 1024) KiB. Imports queue background entity processing. Scanned PDFs need OCR, which is not supported.</p>
        <EditForm Model="metadata" OnValidSubmit="ImportAsync" FormName="source-import" class="editor grid-2">
            <DataAnnotationsValidator /><ValidationSummary />
            <div class="field"><label for="input-kind">Input method</label>
                <select id="input-kind" @bind="inputKind" disabled="@importing"><option value="file">Upload file</option><option value="paste">Paste text</option></select></div>
            @if (inputKind == "file")
            {
                <div class="field"><label for="source-file">Document (.txt or .pdf)</label><InputFile id="source-file" OnChange="SelectFile" accept=".txt,.pdf" disabled="@importing" /></div>
            }
            else
            {
                <div class="field wide"><label for="paste">Source text</label><InputTextArea id="paste" @bind-Value="pastedText" maxlength="2000000" /></div>
            }
            <SourceMetadataFields Model="metadata" />
            <div class="form-actions"><button class="primary" disabled="@importing" type="submit">@(importing ? "Saving original…" : "Import source")</button></div>
        </EditForm>
    </details>
    <div class="section-head"><h2>Source library (@items.Count)</h2></div>
    <form @onsubmit="LoadListAsync" @onsubmit:preventDefault class="filters">
        <label>Search title or text<input @bind="search" maxlength="200" /></label>
        <label>Published from<input type="date" @bind="from" /></label>
        <label>Published through<input type="date" @bind="to" /></label>
        <button type="submit" disabled="@searching">Search</button>
    </form>
    @if (searching) { <p role="status">Searching…</p> }
    else if (items.Count == 0) { <div class="empty"><strong>No sources match this view</strong>Import a document above or change the filters.</div> }
    else
    {
        <div class="data-table-wrap">
            <table class="data-table">
                <thead><tr><th scope="col">Source</th><th scope="col">Type</th><th scope="col">Extraction</th><th scope="col">Reliability</th><th scope="col">Published</th></tr></thead>
                <tbody>
                @foreach (var item in items)
                {
                    <tr><td><a href="@($"/sources/{item.Id}")">@item.Title</a>
                            @if (item.Publisher is not null) { <div class="muted">@item.Publisher</div> }
                            @if (item.ProcessingError is not null) { <p class="row-error">@item.ProcessingError</p> }</td>
                        <td>@item.SourceType</td>
                        <td><StatusTag Value="item.ProcessingStatus" /></td>
                        <td><ReliabilityGrade Grade="item.Reliability" Prefix="" /></td>
                        <td class="mono">@(item.PublishedAt?.ToString("yyyy-MM-dd") ?? "Unknown")</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
}
@code {
    [Parameter] public Guid Id { get; set; }
    private InvestigationResponse? investigation;
    private ImportSettings? limits;
    private List<SourceSummary> items = [];
    private SourceMetadataRequest metadata = new();
    private IBrowserFile? file;
    private string inputKind = "file", pastedText = "", search = "";
    private DateOnly? from, to;
    private string? error;
    private Guid? duplicateId;
    private bool loading = true, importing, searching;
    protected override async Task OnParametersSetAsync()
    {
        loading = true; error = null; file = null; metadata = new();
        try
        {
            investigation = await Investigations.GetAsync(Id);
            if (investigation is null) { error = "Investigation not found."; return; }
            limits = await Sources.SettingsAsync();
            items = await Sources.ListAsync(Id);
        }
        catch (HttpRequestException) { error = "Unable to load the source library. Check the API and reload."; }
        catch (TaskCanceledException) { error = "The request timed out. Reload to retry."; }
        finally { loading = false; }
    }
    private void SelectFile(InputFileChangeEventArgs e)
    {
        file = e.File;
        if (string.IsNullOrWhiteSpace(metadata.Title)) metadata.Title = System.IO.Path.GetFileNameWithoutExtension(file.Name);
    }
    private async Task LoadListAsync()
    {
        searching = true; error = null;
        try { items = await Sources.ListAsync(Id, search, from, to); }
        catch (HttpRequestException ex) { error = ClientErrors.Describe(ex); }
        catch (TaskCanceledException) { error = "Search timed out. Retry."; }
        finally { searching = false; }
    }
    private async Task ImportAsync()
    {
        importing = true; error = null; duplicateId = null;
        try
        {
            SourceResponse result;
            if (inputKind == "file")
            {
                if (file is null) { error = "Choose a document first."; return; }
                if (file.Size > limits!.MaxFileBytes) { error = "The document exceeds the configured size limit."; return; }
                await using var stream = file.OpenReadStream(limits!.MaxFileBytes);
                result = await Sources.UploadAsync(Id, metadata, file.Name, stream);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(pastedText)) { error = "Paste nonempty source text first."; return; }
                result = await Sources.PasteAsync(Id, new() { Title = metadata.Title, Publisher = metadata.Publisher,
                    OriginalUrl = metadata.OriginalUrl, PublishedAt = metadata.PublishedAt, Reliability = metadata.Reliability, Text = pastedText });
            }
            Navigation.NavigateTo($"/sources/{result.Source.Id}?imported=true");
        }
        catch (SourceHttpException ex) { error = ex.Message; duplicateId = ex.ExistingSourceId; }
        catch (HttpRequestException) { error = "Import failed. Check the API and retry."; }
        catch (IOException) { error = "Unable to read the selected file. Select it again and retry."; }
        catch (TaskCanceledException) { error = "Import timed out. Check the library before retrying."; }
        finally { importing = false; }
    }
}

@page "/investigations/{Id:guid}/entities"
@rendermode InteractiveServer
@inject IntelligenceApiClient Client
@inject InvestigationClient Investigations
<PageTitle>ARGUS | Entities</PageTitle>
<InvestigationNav Id="Id" />
<div class="page-head">
    <div>
        <h1>Entities and review</h1>
        <p class="lede">People, organizations and places enter the investigation only after an analyst approves a source mention.</p>
    </div>
</div>
@if (error is not null) { <ErrorNotice Message="@error" /> }
@if (investigation is null && error is null) { <p role="status">Loading investigation…</p> }
else if (investigation is not null)
{
    <EntityReviewPanel @key="Id" InvestigationId="Id" Reviewed="LoadAsync" />
    <div class="section-head"><h2>Approved entities</h2>@if (items is not null) { <span class="count">@items.Total total</span> }</div>
    <form @onsubmit="SearchAsync" @onsubmit:preventDefault class="filters"><label>Canonical name<input @bind="search" maxlength="200" /></label><button type="submit">Search entities</button></form>
    @if (items is null && error is null) { <p role="status">Loading entities…</p> }
    else if (items is not null)
    {
        @if (items.Total == 0) { <div class="empty"><strong>No approved entities match this view</strong>Approve proposed mentions above, or clear the search.</div> }
        else
        {
            <div class="data-table-wrap"><table class="data-table">
                <thead><tr><th scope="col">Canonical name</th><th scope="col">Classification</th><th scope="col" class="num">Approved mentions</th></tr></thead>
                <tbody>
                @foreach (var entity in items.Items)
                { <tr><td><a href="@($"/entities/{entity.Id}")">@entity.Name</a></td><td><span class="tag tag-type">@entity.Type</span></td><td class="num">@entity.MentionCount</td></tr> }
                </tbody></table></div>
        }
        <div class="pager"><button disabled="@(page == 1)" @onclick="() => PageAsync(-1)">Previous entities</button><span>Page @(page) / @items.Total entities</span>
            <button disabled="@(page * items.PageSize >= items.Total)" @onclick="() => PageAsync(1)">Next entities</button></div>
    }
}
@code {
    [Parameter] public Guid Id { get; set; }
    private InvestigationResponse? investigation;
    private PageResult<EntityResponse>? items;
    private string? error;
    private string search = "";
    private int page = 1;
    protected override async Task OnParametersSetAsync()
    {
        try { investigation = await Investigations.GetAsync(Id); if (investigation is null) error = "Investigation not found."; else await LoadAsync(); }
        catch (HttpRequestException) { error = "Unable to load investigation. Check the API."; }
        catch (TaskCanceledException) { error = "Investigation loading timed out."; }
    }
    private async Task LoadAsync()
    {
        try { items = await Client.EntitiesAsync(Id, search, page); }
        catch (HttpRequestException ex) { error = ClientErrors.Describe(ex); }
        catch (TaskCanceledException) { error = "Entity loading timed out."; }
    }
    private async Task SearchAsync() { page = 1; await LoadAsync(); }
    private async Task PageAsync(int delta) { page += delta; await LoadAsync(); }
}

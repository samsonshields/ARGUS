@page "/investigations/{Id:guid}"
@rendermode InteractiveServer
@inject InvestigationClient Client
@inject NavigationManager Navigation
<PageTitle>ARGUS | Investigation overview</PageTitle>
<InvestigationNav Id="Id" />
@if (error is not null) { <ErrorNotice Message="@error" /> }
@if (loading) { <p role="status">Loading investigation…</p> }
else if (item is not null)
{
    @if (Saved) { <p role="status" class="success">Investigation saved.</p> }
    <div class="page-head">
        <div><h1>@item.Title</h1></div>
        <div class="actions"><a class="button" href="@($"/investigations/{Id}/edit")">Edit details / archive</a>
            <a class="button primary" href="@($"/investigations/{Id}/sources")">Source library</a></div>
    </div>
    <div class="overview-grid">
        <div>
            <section class="panel" aria-label="Investigation summary">
                <p class="description">@(string.IsNullOrEmpty(item.Description) ? "No description provided." : item.Description)</p>
            </section>
            <h2 id="workflow-heading">Analytic workflow</h2>
            <ol class="workflow" aria-labelledby="workflow-heading">
                <li><a href="@($"/investigations/{Id}/sources")">Sources</a><span>Import originals; text is extracted and preserved as a snapshot.</span></li>
                <li><a href="@($"/investigations/{Id}/entities")">Entities and review</a><span>Approve, correct or reject machine-proposed mentions.</span></li>
                <li><a href="@($"/investigations/{Id}/relationships")">Relationship review</a><span>Substantiate co-mention proposals with cited passages.</span></li>
                <li><a href="@($"/investigations/{Id}/graph")">Relationship graph</a><span>Inspect structure, paths and centrality across reviewed links.</span></li>
                <li><a href="@($"/investigations/{Id}/timeline")">Timeline and event review</a><span>Order events while keeping month, year and unknown precision.</span></li>
                <li><a href="@($"/investigations/{Id}/map")">Geography and locations</a><span>Place approved locations with explicit uncertainty radii.</span></li>
                <li><a href="@($"/investigations/{Id}/assessments")">Assessments and claims</a><span>Weigh supporting and contradicting evidence; record confidence.</span></li>
                <li><a href="@($"/investigations/{Id}/reports")">Markdown reports</a><span>Export immutable, source-referenced report snapshots.</span></li>
            </ol>
        </div>
        <aside>
            <section class="panel" aria-labelledby="facts-heading">
                <h2 id="facts-heading">Case record</h2>
                <dl class="facts">
                    <dt>Status</dt><dd><StatusTag Value="item.Status" /></dd>
                    <dt>Region</dt><dd>@(item.Region ?? "Unspecified")</dd>
                    <dt>Research scope</dt><dd class="mono">@(item.StartDate?.ToString("yyyy-MM-dd") ?? "Unknown") to @(item.EndDate?.ToString("yyyy-MM-dd") ?? "Unknown")</dd>
                    <dt>Created (UTC)</dt><dd class="mono">@item.CreatedAt.ToString("u")</dd>
                    <dt>Updated (UTC)</dt><dd class="mono">@item.UpdatedAt.ToString("u")</dd>
                    <dt>Record ID</dt><dd><code>@item.Id</code></dd>
                </dl>
            </section>
            <section class="panel danger-zone"><h2>Delete investigation</h2>
            <p class="muted">Investigations with preserved sources cannot be deleted. Archive them to retain their evidence.</p>
            @if (!confirming) { <button class="danger" @onclick="() => confirming = true">Delete…</button> }
            else
            {
                <p>This permanently removes <strong>@(item.Title)</strong>. This action cannot be undone.</p>
                <div class="actions"><button class="danger" disabled="@deleting" @onclick="DeleteAsync">Confirm permanent deletion</button>
                    <button disabled="@deleting" @onclick="() => confirming = false">Cancel</button></div>
            }
            </section>
        </aside>
    </div>
}
@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public bool Saved { get; set; }
    private InvestigationResponse? item;
    private string? error;
    private bool loading = true, confirming, deleting;
    protected override async Task OnParametersSetAsync()
    {
        loading = true; error = null; confirming = false;
        try { item = await Client.GetAsync(Id); if (item is null) error = "Investigation not found."; }
        catch (HttpRequestException) { error = "Unable to load investigation. Check the API and reload."; }
        catch (TaskCanceledException) { error = "The request timed out. Reload to retry."; }
        finally { loading = false; }
    }
    private async Task DeleteAsync()
    {
        deleting = true;
        try { await Client.DeleteAsync(Id); Navigation.NavigateTo("/investigations"); }
        catch (HttpRequestException ex) { error = ClientErrors.Describe(ex); }
        catch (TaskCanceledException) { error = "Deletion timed out. Check the list before retrying."; }
        finally { deleting = false; }
    }
}

@inject IntelligenceApiClient Client
<section class="panel" data-review-ready="@(interactive ? "true" : "false")">
    <div class="panel-head"><h2>Entity review</h2></div>
    <p class="muted">Proposed mentions are machine suggestions. Similar names do not establish that two people are the same.</p>
    @if (error is not null) { <p role="alert" class="error">@error</p> }
    @if (success is not null) { <p role="status" class="success">@success</p> }
    <form class="filters" @onsubmit="RefreshAsync" @onsubmit:preventDefault>
        <label>Review status<select aria-label="Review status" @bind="status" @bind:after="RefreshAsync" disabled="@busy"><option value="">All review statuses</option><option>PROPOSED</option><option>APPROVED</option><option>REJECTED</option></select></label>
        <label>Candidate type<select aria-label="Candidate type" @bind="type" @bind:after="RefreshAsync" disabled="@busy"><option value="">All candidate types</option>
            @foreach (var candidateType in Enum.GetValues<EntityType>()) { <option>@candidateType</option> }</select></label>
        <label>Candidate text<input aria-label="Candidate text" @bind="search" maxlength="200" placeholder="Search extracted mentions" /></label>
        <button type="submit" disabled="@busy">Refresh candidates</button></form>
    <p class="muted">Each row is a source occurrence, so repeated names have separate evidence. Approved and rejected mentions remain available through Review status; all other source text remains in Extracted text.</p>
    @if (items is null && error is null) { <p role="status">Loading candidates…</p> }
    else if (items is not null)
    {
        @if (items.Total == 0) { <div class="empty">No @(status.Length == 0 ? "matching" : status.ToLowerInvariant()) mentions in this view.</div> }
        else
        {
            <div class="records">
            @foreach (var mention in items.Items)
            {
                <div class="mention-row @(evidence?.Mention.Id == mention.Id ? "selected" : null)" data-status="@mention.Status">
                    <div class="record-main"><button class="record-title" disabled="@busy" @onclick="() => SelectAsync(mention.Id)">@mention.Text</button>
                        <div class="meta"><span class="tag tag-type">@mention.OriginalType</span><StatusTag Value="mention.Status" /><span>@mention.SourceTitle</span></div></div>
                    @if (mention.EntityId.HasValue) { <a href="@($"/entities/{mention.EntityId}")">Approved entity</a> }</div>
            }
            </div>
        }
        <div class="pager"><button disabled="@(page == 1 || busy)" @onclick="() => PageAsync(-1)">Previous mentions</button>
            <span>Page @(page) / @items.Total mentions</span><button disabled="@(page * items.PageSize >= items.Total || busy)" @onclick="() => PageAsync(1)">Next mentions</button></div>
    }
    <MentionEvidenceView Evidence="evidence" />
    @if (evidence?.Mention.Status == ReviewStatus.PROPOSED)
    {
        <EditForm Model="approval" OnValidSubmit="ApproveAsync" FormName="approve-mention" class="editor">
            <DataAnnotationsValidator /><ValidationSummary />
            <label for="entity-choice">Associate with an existing entity, or create one</label>
            <select id="entity-choice" @bind="selectedEntity" @bind:after="ChooseEntity">
                <option value="">Create a new entity</option>
                @foreach (var suggestion in suggestions)
                { <option value="@suggestion.Entity.Id">@suggestion.Entity.Name / @suggestion.Entity.Type (name similarity @suggestion.Similarity.ToString("P0"))</option> }
            </select>
            <label for="review-name">Canonical name</label><InputText id="review-name" @bind-Value="approval.Name" maxlength="200" disabled="@approval.EntityId.HasValue" />
            <label for="review-type">Corrected classification</label><InputSelect id="review-type" @bind-Value="approval.Type" disabled="@approval.EntityId.HasValue">
                @foreach (var type in Enum.GetValues<EntityType>()) { <option value="@type">@type</option> }
            </InputSelect>
            @if (approval.EntityId.HasValue) { <a href="@($"/entities/{approval.EntityId}")">Inspect or correct the selected entity</a> }
            <p class="muted">Original mention text and model classification are retained when you make corrections.</p>
            <div class="actions"><button class="primary" type="submit" disabled="@busy">Approve mention</button>
                <button class="danger" type="button" disabled="@busy" @onclick="RejectAsync">Reject mention</button></div>
        </EditForm>
    }
</section>
@code {
    [Parameter] public Guid InvestigationId { get; set; }
    [Parameter] public Guid? SourceId { get; set; }
    [Parameter] public EventCallback Reviewed { get; set; }
    private PageResult<MentionResponse>? items;
    private MentionEvidence? evidence;
    private List<EntitySuggestion> suggestions = [];
    private ApproveMentionRequest approval = new();
    private string status = "PROPOSED", selectedEntity = "", type = "", search = "";
    private string? error, success;
    private int page = 1, loadVersion;
    private bool busy, interactive;
    protected override Task OnInitializedAsync() => ReloadAsync();
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { interactive = true; StateHasChanged(); }
    }
    public async Task ReloadAsync()
    {
        var version = ++loadVersion;
        try
        {
            var result = await Client.MentionsAsync(InvestigationId, SourceId, null, status, page, type, search);
            if (version != loadVersion) return;
            var lastPage = Math.Max(1, (result.Total + result.PageSize - 1) / result.PageSize);
            if (page > lastPage) { page = lastPage; await ReloadAsync(); return; }
            items = result; error = null;
        }
        catch (HttpRequestException ex) { if (version == loadVersion) error = ClientErrors.Describe(ex); }
        catch (TaskCanceledException) { if (version == loadVersion) error = "Review list timed out. Refresh to retry."; }
    }
    private async Task RefreshAsync() { page = 1; items = null; evidence = null; error = success = null; await ReloadAsync(); }
    private async Task PageAsync(int delta) { page += delta; evidence = null; await ReloadAsync(); }
    private async Task SelectAsync(Guid id)
    {
        busy = true; error = success = null;
        try
        {
            evidence = await Client.EvidenceAsync(id);
            suggestions = await Client.SuggestionsAsync(id);
            selectedEntity = ""; approval = new() { Name = evidence.Mention.Text, Type = evidence.Mention.OriginalType };
        }
        catch (HttpRequestException ex) { error = ClientErrors.Describe(ex); }
        catch (TaskCanceledException) { error = "Candidate loading timed out."; }
        finally { busy = false; }
    }
    private void ChooseEntity()
    {
        approval.EntityId = Guid.TryParse(selectedEntity, out var id) ? id : null;
        var selected = suggestions.FirstOrDefault(x => x.Entity.Id == approval.EntityId);
        approval.Name = selected?.Entity.Name ?? evidence!.Mention.Text;
        approval.Type = selected?.Entity.Type ?? evidence!.Mention.OriginalType;
    }
    private async Task ApproveAsync() => await ReviewAsync(true);
    private async Task RejectAsync() => await ReviewAsync(false);
    private async Task ReviewAsync(bool approve)
    {
        if (evidence is null) return;
        busy = true; error = null;
        try
        {
            if (approve) await Client.ApproveAsync(evidence.Mention.Id, approval); else await Client.RejectAsync(evidence.Mention.Id);
            evidence = null; success = approve ? "Mention approved. The entity is now in the investigation entity list." : "Mention rejected; its source provenance is retained.";
            await ReloadAsync(); await Reviewed.InvokeAsync();
        }
        catch (HttpRequestException ex) { error = ClientErrors.Describe(ex); }
        catch (TaskCanceledException) { error = "Review timed out. Refresh before retrying."; }
        finally { busy = false; }
    }
}

@inherits LayoutComponentBase
@inject IConfiguration Configuration
<a class="skip-link" href="#main-content">Skip to workspace</a>
@if (!string.IsNullOrWhiteSpace(marking)) { <div class="marking marking-top" role="note" aria-label="Data handling marking">@marking</div> }
<div class="shell">
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="/" aria-label="ARGUS dashboard">
                <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                    <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="16" cy="16" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2.4" />
                    <circle cx="16" cy="16" r="3" fill="currentColor" />
                </svg>
                <span class="brand-name">ARGUS</span>
            </a>
            <nav class="main-nav" aria-label="Main navigation">
                <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink href="/investigations">Investigations</NavLink>
                <NavLink href="/processing-jobs">Processing jobs</NavLink>
                <NavLink href="/workspace-backup">Workspace backup</NavLink>
            </nav>
            <div class="topbar-meta">
                <span class="pill pill-live"><span class="dot" aria-hidden="true"></span>Local workspace</span>
                <time class="utc-clock" data-utc-clock datetime="@now.ToString("O")" title="Coordinated Universal Time">@now.ToString("yyyy-MM-dd HH:mm")Z</time>
            </div>
        </div>
    </header>
    <main id="main-content">@Body</main>
    <footer class="site-foot">
        <div class="site-foot-inner">
            <div>
                <a class="brand" href="/" aria-label="ARGUS dashboard"><span class="brand-name">ARGUS</span></a>
                <p class="muted">Evidence workstation for open-source research. Sources, evidence and reports stay on this machine.</p>
            </div>
            <nav class="foot-nav" aria-label="Footer">
                <a href="/">Dashboard</a>
                <a href="/investigations">Investigations</a>
                <a href="/processing-jobs">Processing jobs</a>
                <a href="/workspace-backup">Workspace backup</a>
            </nav>
        </div>
    </footer>
</div>
@if (!string.IsNullOrWhiteSpace(marking)) { <div class="marking marking-bottom" role="note" aria-label="Data handling marking">@marking</div> }
<div id="blazor-error-ui" role="alert">Connection to the workstation server was interrupted. <a href="" class="reload">Reload</a></div>
@code {
    private string? marking;
    private DateTime now;
    protected override void OnInitialized()
    {
        marking = Configuration["Workstation:Marking"];
        now = DateTime.UtcNow;
    }
}

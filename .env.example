# Reference only; .NET reads environment variables, not this file automatically.
ARGUS_DATA_DIRECTORY=C:/Argus/data
Api__BaseUrl=http://localhost:5100
Documents__MaxFileBytes=10485760
Documents__MaxExtractedCharacters=2000000
Documents__MaxPdfPages=500
Documents__ExtractionTimeoutSeconds=20
Intelligence__BaseUrl=http://localhost:8000
Intelligence__TimeoutSeconds=30
Intelligence__WorkerEnabled=true
Intelligence__AutoProcessImports=true
Intelligence__MaxAttempts=3
Intelligence__RetryDelaySeconds=5
Intelligence__MaxTextCharacters=250000
Intelligence__MatchThreshold=0.85
ARGUS_SPACY_MODEL=en_core_web_sm
ARGUS_NLP_MAX_UTF16=250000
